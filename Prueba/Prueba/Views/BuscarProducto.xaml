<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="Prueba.Views.BuscarProducto"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Prueba.Models">

    <Grid
        Padding="24"
        RowSpacing="14"
        ColumnSpacing="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Buscar productos"
            FontSize="30"
            FontWeight="Bold"
            Foreground="#49366B"/>

        <TextBox
            Grid.Row="1"
            x:Name="BusquedaTextBox"
            Width="480"
            HorizontalAlignment="Left"
             PlaceholderText="Nombre, marca, tipo, categoría o variante"
            TextChanged="BusquedaTextBox_TextChanged"/>

        <TextBlock
            Grid.Row="2"
            x:Name="ContadorTextBlock"
            Foreground="#6B5B80"/>

        <ListView
            Grid.Row="3"
            x:Name="ProductosListView"
            SelectionMode="None">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Producto">
                    <Border
                        Background="White"
                        CornerRadius="10"
                        Padding="16,12">

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="100"/>
                                <ColumnDefinition Width="Auto" MinWidth="90"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image
                                Grid.Column="0"
                                Source="{x:Bind ImagenFuente}"
                                Width="96"
                                Height="96"
                                Stretch="UniformToFill"
                                VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    Text="{x:Bind Nombre}"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Foreground="#49366B"
                                    TextWrapping="Wrap"/>
                                <TextBlock
                                    Text="{x:Bind Marca}"
                                    Foreground="#8C3F67"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap"/>
                                <TextBlock
                                    Text="{x:Bind Detalle}"
                                    Foreground="#6B5B80"
                                    TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Text="{x:Bind ExistenciaTexto}"
                                    FontWeight="SemiBold"/>
                                <TextBlock
                                    Text="{x:Bind ImportadoTexto}"
                                    FontSize="12"
                                    Foreground="#6B5B80"/>
                            </StackPanel>

                            <TextBlock
                                Grid.Column="3"
                                Text="{x:Bind PrecioTexto}"
                                FontSize="17"
                                FontWeight="Bold"
                                Foreground="#8C3F67"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>

                            <StackPanel
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Spacing="4">
                                <Button
                                    Content="Editar"
                                    Click="EditarProducto_Click"
                                    Tag="{x:Bind Id}"
                                    Background="#E9DDF7"
                                    Foreground="#49366B"
                                    Padding="8,4"
                                    FontSize="14"/>
                                <Button
                                    Content="Eliminar"
                                    Click="EliminarProducto_Click"
                                    Tag="{x:Bind Id}"
                                    Background="#FBE3EE"
                                    Foreground="#8C3F67"
                                    Padding="8,4"
                                    FontSize="14"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Grid.Row="3"
            x:Name="SinResultadosTextBlock"
            Text="No se encontraron productos."
            Visibility="Collapsed"
            Margin="0,12,0,0"
            FontSize="15"/>
    </Grid>
</Page>