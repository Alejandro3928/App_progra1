<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Prueba.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Prueba"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <StackPanel
            x:Name="LoginPanel"
            Width="350"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <TextBlock
            Text="Iniciar sesión"
            FontSize="32"
            HorizontalAlignment="Center"
            Margin="0,0,0,30"/>

                <TextBox
            x:Name="UsuarioTextBox"
            Header="Usuario"
            PlaceholderText="Escribe tu usuario"
            Margin="0,0,0,15"/>

                <PasswordBox
            x:Name="PasswordBox"
            Header="Contraseña"
            PlaceholderText="Escribe tu contraseña"
            Margin="0,0,0,20"/>

                <Button
            x:Name="IngresarButton"
            Content="Ingresar"
            Click="IngresarButton_Click"
            HorizontalAlignment="Center"
            Width="150"/>
                
                <TextBlock
                    x:Name="MensajeError"
                    Foreground="Red"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"/>
               
            <Button
                Content="Crear cuenta"
                Click="CrearCuentaButton_Click"
                HorizontalAlignment="Center"
                Margin="0,10,0,0"
                Background="Transparent"
                Foreground="#49366B"/>
        </StackPanel>

        <StackPanel
            x:Name="CrearCuentaPanel"
            Width="350"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <TextBlock
                Text="Crear cuenta"
                FontSize="32"
                HorizontalAlignment="Center"
                Margin="0,0,0,30"/>

            <TextBox
                x:Name="NuevoUsuarioTextBox"
                Header="Usuario"
                PlaceholderText="Escribe un usuario"
                Margin="0,0,0,15"/>

            <PasswordBox
                x:Name="NuevaContrasenaPasswordBox"
                Header="Contraseña"
                PlaceholderText="Mínimo 6 caracteres"
                Margin="0,0,0,15"/>

            <PasswordBox
                x:Name="ConfirmarContrasenaPasswordBox"
                Header="Confirmar contraseña"
                PlaceholderText="Repite la contraseña"
                Margin="0,0,0,20"/>

            <Button
                Content="Registrar cuenta"
                Click="RegistrarCuentaButton_Click"
                HorizontalAlignment="Center"
                Width="150"/>

            <Button
                Content="Volver al inicio de sesión"
                Click="CancelarCrearCuentaButton_Click"
                HorizontalAlignment="Center"
                Margin="0,10,0,0"
                Background="Transparent"
                Foreground="#49366B"/>

            <TextBlock
                x:Name="MensajeRegistro"
                Foreground="Red"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</Page>
