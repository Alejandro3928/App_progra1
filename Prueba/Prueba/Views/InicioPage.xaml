<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="Prueba.Views.InicioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Prueba.Models">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="20">

            <TextBlock
                Text="¡Bienvenido a Fiesta!"
                FontSize="30"
                FontWeight="Bold"
                Foreground="#49366B"/>

            <TextBlock
                Text="Administra los artículos para fiestas"
                FontSize="16"
                TextWrapping="Wrap"/>

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Tapped="RegistrarProductoBorder_Tapped"
                    Background="#E9DDF7"
                    CornerRadius="12"
                    Padding="20">
                    <StackPanel Spacing="10">
                        <FontIcon
                            Glyph="&#xE710;"
                            FontSize="28"
                            Foreground="#49366B"/>
                        <TextBlock
                            Text="Registrar productos"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Foreground="#49366B"
                            TextWrapping="Wrap"/>
                        <TextBlock
                            Text="Agrega nuevos artículos al inventario."
                            TextWrapping="Wrap"
                            Foreground="#49366B"/>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Tapped="ExistenciasCard_Tapped"
                    Background="#FBE3EE"
                    CornerRadius="12"
                    Padding="20">
                    <StackPanel Spacing="10">
                        <FontIcon
                            Glyph="&#xE721;"
                            FontSize="28"
                            Foreground="#8C3F67"/>
                        <TextBlock
                            Text="Control de existencias"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Foreground="#8C3F67"
                            TextWrapping="Wrap"/>
                        <TextBlock
                            Text="Consulta y actualiza las piezas disponibles."
                            TextWrapping="Wrap"
                            Foreground="#8C3F67"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RESUMEN (solo se ve cuando ya hay productos) -->
            <StackPanel x:Name="ResumenPanel" Spacing="16" Visibility="Collapsed">

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Productos registrados" Foreground="#6B5B80"/>
                            <TextBlock
                                x:Name="TotalProductosTextBlock"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="#49366B"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Piezas en existencia" Foreground="#6B5B80"/>
                            <TextBlock
                                x:Name="TotalPiezasTextBlock"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="#49366B"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Con poco stock (5 o menos)" Foreground="#6B5B80"/>
                            <TextBlock
                                x:Name="PocoStockCountTextBlock"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="#8C3F67"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    x:Name="ReponerBorder"
                    Tapped="ReponerBorder_Tapped"
                    Background="White"
                    CornerRadius="12"
                    Padding="22"
                    Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="Necesitan reposición"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="#49366B"/>

                        <ItemsControl x:Name="ReponerItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Producto">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind Nombre}"
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind ExistenciaTexto}"
                                            FontWeight="Bold"
                                            Foreground="#8C3F67"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            x:Name="VerMasTextBlock"
                            Text="Toca aquí para ver el reporte completo."
                            FontSize="12"
                            Foreground="#6B5B80"
                            Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- PRIMEROS PASOS (solo se ve mientras no hay productos) -->
            <Border
                x:Name="PrimerosPasosBorder"
                Background="White"
                CornerRadius="12"
                Padding="22">
                <StackPanel Spacing="8">
                    <TextBlock
                        Text="Primeros pasos"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="#49366B"/>

                    <TextBlock
                        Text="1. Entra a Registrar producto."
                        TextWrapping="Wrap"/>

                    <TextBlock
                        Text="2. Captura los datos del artículo."
                        TextWrapping="Wrap"/>

                    <TextBlock
                        Text="3. Pulsa Guardar producto."
                        TextWrapping="Wrap"/>

                    <TextBlock
                        Text="Los productos registrados se almacenan en una base de datos local."
                        TextWrapping="Wrap"
                        Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
