<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Prueba.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Prueba.Views"
    Title="Little´s Party - Inventario">

    <Grid>
        <NavigationView
            x:Name="MenuPrincipal"
            Visibility="Collapsed"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="MenuPrincipal_SelectionChanged"
            Background="{StaticResource FondoPrincipal}"
            Foreground="{StaticResource TextoPrincipal}"
            AlwaysShowHeader="True">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Inicio"
                    Tag="Inicio"
                    IsSelected="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="Registrar producto"
                    Tag="Registrar">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Add"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="Buscar productos"
                    Tag="Buscar">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Find"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="Actualizar inventario"
                    Tag="Actualizar">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Refresh"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="Reportes"
                    Tag="Reportes">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="Globby"
                    Tag="Globby">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Message"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.Header>
                <StackPanel Spacing="3" Margin="8,8,0,8">
                    <TextBlock
                        Text="Little´s Party"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{StaticResource AzulMarino}"/>

                    <TextBlock
                        Text="Control de inventario"
                        FontSize="13"
                        Foreground="{StaticResource TextoSecundario}"/>
                </StackPanel>
            </NavigationView.Header>

            <Frame x:Name="MainFrame"/>
        </NavigationView>

        <Frame x:Name="LoginFrame"/>
    </Grid>
</Window>
