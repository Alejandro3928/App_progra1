<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Prueba.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Prueba"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid>

            <StackPanel
        Width="350"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

                <TextBlock
            Text="Iniciar sesión"
            FontSize="32"
            HorizontalAlignment="Center"
            Margin="0,0,0,30"/>

                <TextBox
            x:Name="UsuarioTextBox"
            Header="Usuario"
            PlaceholderText="Escribe tu usuario"
            Margin="0,0,0,15"/>

                <PasswordBox
            x:Name="PasswordBox"
            Header="Contraseña"
            PlaceholderText="Escribe tu contraseña"
            Margin="0,0,0,20"/>

                <Button
            x:Name="IngresarButton"
            Content="Ingresar"
            Click="IngresarButton_Click"
            HorizontalAlignment="Center"
            Width="150"/>
                
                <TextBlock
                    x:Name="MensajeError"
                    Foreground="Red"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"/>
               
            </StackPanel>
        </Grid>

    </Grid>
</Page>
